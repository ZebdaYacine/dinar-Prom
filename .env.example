# Dinar DZ shared environment template.
# Copy to .env for local Docker Compose. Never commit .env or real secrets.
# Compose, api, worker, web, and minio-init consume this same file.

COMPOSE_PROJECT_NAME=dinar
SHARED_ENV_FILE=.env
APP_ENV=development
APP_URL=http://localhost:8180
API_ADDR=:8080
API_INTERNAL_URL=http://api:8080
API_PUBLIC_URL=http://localhost:8188

# Next.js values exposed to the browser must be non-secret.
NEXT_PUBLIC_APP_URL=http://localhost:8180
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9100/dinar-public
# Leave empty to derive ws/wss from the current browser origin through Caddy.
NEXT_PUBLIC_WS_URL=

POSTGRES_DB=dinar
POSTGRES_USER=dinar
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://dinar:change-this-local-password@postgres:5432/dinar?sslmode=disable

REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_PREFIX=dinar:
REDIS_CHANNEL_NOTIFICATIONS=dinar:notifications

# MinIO root credentials are for minio-init/admin operations only.
MINIO_ROOT_USER=change-this-minio-root-user
MINIO_ROOT_PASSWORD=change-this-minio-root-password
# Use a separate application user, never the MinIO root user.
MINIO_ACCESS_KEY=dinar-app
MINIO_SECRET_KEY=change-this-minio-app-secret
MINIO_ENDPOINT=minio:9000
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_BUCKET_PUBLIC=dinar-public
MINIO_BUCKET_PRIVATE=dinar-private

JWT_ISSUER=dinar-api
JWT_AUDIENCE=dinar-web
JWT_ALGORITHM=RS256
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_SECONDS=2592000
JWT_CLOCK_SKEW_SECONDS=30
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key
REFRESH_TOKEN_COOKIE_NAME=dinar_refresh
COOKIE_SECURE=false
CSRF_COOKIE_NAME=dinar_csrf
CSRF_HEADER_NAME=X-CSRF-Token
WS_TICKET_TTL_SECONDS=30
ALLOWED_ORIGINS=http://localhost:8180,http://localhost:3143
TRUSTED_HOSTS=localhost,127.0.0.1
CASBIN_MODEL_PATH=/app/authz/model.conf
CASBIN_POLICY_SOURCE=postgres
ADMIN_EMAILS=admin@example.com
IP_HASH_SALT=change-this-long-random-salt

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8180/api/v1/auth/google/callback

CHARGILY_BASE_URL=https://pay.chargily.net/test/api/v2
CHARGILY_API_KEY=
CHARGILY_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dinar DZ <no-reply@dinar.dz>"

# Real-time notification channel.
NOTIFICATIONS_WS_ENABLED=true
NOTIFICATIONS_WS_PATH=/api/v1/ws/notifications
WS_ALLOWED_ORIGINS=http://localhost:8180,http://localhost:3143
WS_MAX_CONNECTIONS_PER_USER=3
WS_PING_INTERVAL_SECONDS=25
WS_READ_TIMEOUT_SECONDS=45
WS_WRITE_TIMEOUT_SECONDS=10
WS_EVENT_MAX_BYTES=16384
