(dinar_local_proxy) {
  encode zstd gzip
  header -Server

  handle /api/* {
    reverse_proxy api:8080
  }

  handle /dinar-public/* {
    reverse_proxy minio:9000
  }

  handle {
    reverse_proxy web:3000
  }
}

:80 {
  import dinar_local_proxy
}

:443 {
  tls internal
  import dinar_local_proxy
}
